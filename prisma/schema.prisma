generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoProduto {
  passeio
  aluguel
  venda
}

enum Categoria {
  jetski
  lancha
  casa
  chale
}

model Produto {
  id        String        @id @default(cuid())
  titulo    String
  preco     Float
  descricao String
  tipo      TipoProduto   // passeio | aluguel | venda
  categoria Categoria     // jetski, lancha, casa, etc
  imagens   String[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}